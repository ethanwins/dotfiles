{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",   "source": "~/.config/fastfetch/beach.png",
	"height": 10,
        "padding": {
            "top": 2,
	    "left": 0,
	    "right": 2
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        "title",
        {
            "type": "os",
            "key": "os    ",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "green"
        },
        {
            "type": "host",
            "format": "{vendor} {family}",
            "key": "host  ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "pkgs  ",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "format": "{?days}{days}d {?}{hours}h {minutes}m",
            "key": "uptime",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "cyan"
        },
	{
	    "type": "cpu",
	    "key": "cpu   ",
	    "keyColor": "red"
	},
	{
	    "type": "gpu",
	    "key": "gpu   ",
	    "format": "{name}",
	    "keyColor": "green"
	},
	{
	    "type": "media",
	    "key": "media ",
	    "keyColor": "yellow"
	},
        "break"
    ]
}
